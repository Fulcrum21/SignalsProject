# Preserve the exact bytes used by the report's SHA-256 evidence on checkout.
* -text whitespace=cr-at-eol
*.pdf binary
*.png binary
*.wav binary
*.mat binary
*.zip binary
*.slx binary
# MATLAB's captured console tables contain intentional trailing spaces.
results/** whitespace=cr-at-eol,-blank-at-eol
Demo/Results/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
